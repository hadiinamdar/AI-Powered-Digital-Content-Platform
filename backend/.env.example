# JZD Content Studio — live configuration
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///./jzd.db
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Email / OTP
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Use a verified sender domain for production. Resend's onboarding sender has restrictions.
RESEND_FROM=JZD Content Studio <onboarding@resend.dev>
RESEND_TEST_RECIPIENT=
OTP_DEBUG_EXPOSE=false
OTP_EXPIRE_MINUTES=5

# AI content generation
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Social publishing: mock until platform credentials are supplied.
PUBLISH_MODE=mock
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE_NUMBER=

# Seed admin account
SEED_ADMIN_EMAIL=admin@jzdtechnologies.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=JZD Admin
